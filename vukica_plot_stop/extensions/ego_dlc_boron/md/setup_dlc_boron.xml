        <cue name="Alliance_War_Trinity_Check" onfail="cancel" comment="check if the event completed before we start listening">
          <conditions>
            <cue_is_complete cue="md.Story_Paranid.Tri_War_Diplomatic_Change"/>
          </conditions>
          <actions>
            <signal_cue cue="Alliance_War_Trinity_Event"/>
          </actions>
        </cue>
        <cue name="Alliance_War_Trinity_Event">
          <conditions>
            <check_any>
              <event_cue_signalled/>
              <event_cue_signalled cue="md.Story_Paranid.Tri_War_Diplomatic_Change"/>
              <event_cue_completed cue="md.Story_Paranid.Tri_War_Diplomatic_Change"/>
            </check_any>
            <check_value value="md.Story_Paranid.Start.$TranslatedWarTargets.indexof.{faction.argon}"/>
          </conditions>
          <actions>
            <set_faction_relation faction="faction.trinity" otherfaction="faction.boron" value="faction.trinity.relation.killmilitary.max"/>
          </actions>
        </cue>
      </cues>
    </cue>
