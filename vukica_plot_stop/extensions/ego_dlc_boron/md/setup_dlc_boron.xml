  <replace sel="//cue[@name='DEBUG_BoronFaction_ActivateKingdomEnd']">
    <cue name="Split_Raid_Handling">
      <cues>
        <cue name="Check_For_SplitShips" instantiate="true" checkinterval="5min">
          <conditions>
            <count_ships result="$SplitRaidShips" job="'zyarth_corvette_m_raid'" multiple="true" space="$HereticsEndSector" commandeerable="true"/>
          </conditions>
          <actions>
            <do_for_each name="$RaidCommander" in="$SplitRaidShips">
              <do_any>
                <set_value name="this.$Destination" exact="$WatchfulGazeSector" weight="3"/>
                <set_value name="this.$Destination" exact="$BarrenShoresSector" weight="2"/>
                <set_value name="this.$Destination" exact="$GreatReefSector" weight="1"/>
              </do_any>
              <commandeer_object object="$RaidCommander"/>
              <cancel_all_orders object="$RaidCommander"/>
              <create_order object="$RaidCommander" id="'MoveGeneric'">
                <param name="destination" value="this.$Destination"/>
              </create_order>
              <create_order object="$RaidCommander" id="'Patrol'" default="true">
                <param name="space" value="this.$Destination"/>
              </create_order>
            </do_for_each>
          </actions>
        </cue>
      </cues>
    </cue>
  </replace>
