<?xml version='1.0' encoding='utf-8'?>
<diff>
  <remove sel="//mdscript/cues/cue/@version"/>
  <remove sel="//set_value[@name='$DeepDebugChance']"/>
  <remove sel="//set_value[@name='$Page']"/>
  <remove sel="//mdscript/cues/cue/actions[1]/set_value[@name='md.Signal_Leaks.Manager.$SuppressSignalLeakGeneration']"/>
  <remove sel="//mdscript/cues/cue/patch"/>
  <remove sel="//cue[@name='Setup']/@version"/>
  <remove sel="//cue[@name='Setup']/actions[1]"/>
  <remove sel="//cue[@name='Setup']/actions/signal_cue"/>
  <replace sel="//cue[@name='Setup']/patch">
    <delay exact="5s"/>
  </replace>
  <add sel="//cue[@name='Setup']/cues" pos="before">
    <actions>
      <signal_cue cue="Ch1_Intro"/>
    </actions>
  </add>
  <remove sel="//find_object_component[@name='$PrisonCorridor']"/>
  <remove sel="//set_value[@name='$PrisonRoom2']"/>
  <remove sel="//set_value[@name='$PrisonRoom4']"/>
  <remove sel="//cue[@name='Setup_Other_Player_Prisoner']"/>
  <remove sel="//cue[@name='LockedDoorsHandler']"/>
  <remove sel="//cue[@name='Setup_Axiom']"/>
  <remove sel="//cue[@name='Axiom_Comments']"/>
  <remove sel="//cue[@name='Ch0_Wait']"/>
  <remove sel="//cue[@name='Ch1_Intro']/actions/set_value[@name='$ObjectiveStep']"/>
  <remove sel="//cue[@name='Ch1_Intro']/actions/create_mission"/>
  <remove sel="//cue[@name='Ch1_Intro']/actions/set_objective_from_briefing"/>
  <remove sel="//cue[@name='Ch1_SetupCrate']"/>
  <remove sel="//cue[@name='Ch1_SetupRemoveLeaks']"/>
  <remove sel="//cue[@name='Ch1_SetupPrisonEffects']"/>
  <remove sel="//cue[@name='Ch1_SetupEscape']"/>
  <replace sel="//cue[@name='Ch1_Axiom_Conversation3']/@name">Ch1_SetupCrate</replace>
  <remove sel="//cue[@name='Ch1_SetupCrate']/conditions"/>
  <replace sel="//cue[@name='Ch1_SetupCrate']/actions/speak">
    <find_crate_slot name="$CrateSlots" object="$PrisonRoom3" tags="[tag.crate_s, tag.crate_ontable]" multiple="true"/>
  </replace>
  <add sel="//cue[@name='Ch1_SetupCrate']/actions">
    <debug_text text="'Found #crateslots:' + $CrateSlots.count" chance="$DebugChance"/>
  </add>
  <add sel="//cue[@name='Ch1_SetupCrate']/actions">
    <create_crate name="$ToolboxCrate" macro="macro.crate_gen_s_01_macro" slot="$CrateSlots.random"/>
  </add>
  <add sel="//cue[@name='Ch1_SetupCrate']/actions">
    <add_cargo object="$ToolboxCrate" ware="ware.weapon_gen_spacesuit_laser_01_mk1" exact="1"/>
  </add>
  <remove sel="//cue[@name='Ch1_Intro']/cues/library"/>
  <remove sel="//cue[@name='Ch1_Axiom_Conversation_Started']"/>
  <remove sel="//cue[@name='Ch1_Escape_LeaveCell']"/>
  <remove sel="//cue[@name='Ch1_Escape_NearConsole']"/>
  <remove sel="//cue[@name='Ch1_Escape_LeaveRoom']"/>
  <replace sel="//cue[@name='Ch2_Other_Prisoner_Conversation_Axiom_Comment']/@name">Ch1_SetupPrisonEffects</replace>
  <remove sel="//cue[@name='Ch1_SetupPrisonEffects']/conditions"/>
  <remove sel="//cue[@name='Ch1_SetupPrisonEffects']/actions[1]"/>
  <replace sel="//cue[@name='Ch1_SetupPrisonEffects']/actions[1]/do_if">
    <add_effect object="$PrisonRoom" effect="'sparks_90deg_bursts_v1_tiny'">
      <position space="$PrisonRoom" x="-1.9m" y="1.34m" z="-4.88m"/>
    </add_effect>
  </replace>
  <add sel="//cue[@name='Ch1_SetupPrisonEffects']/actions[1]">
    <add_effect object="$PrisonRoom" effect="'sparks_90deg_bursts_v1_tiny'">
      <position space="$PrisonRoom" x="3.01m" y="0.87m" z="-2.4m"/>
    </add_effect>
  </add>
  <remove sel="//cue[@name='Ch1_SetupPrisonEffects']/delay[@exact='8s']"/>
  <remove sel="//cue[@name='Ch1_SetupPrisonEffects']/actions[2]"/>
  <replace sel="//cue[@name='Ch2_Corridor_Guidance1']">
    <cue name="Ch1_SetupEscape">
      <actions>
        <find_object_component name="$PrisonMarker_25" groupname="$PrisonMarkerGroup" object="$PrisonModule" macro="macro.positiondummy25_macro" required="true" comment="In the upward curve of the escape-pipe (for navigating Axiom)"/>
        <delay exact="2s"/>
        <create_mission cue="$MissionCue" name="'Escape'" description="'Find a way out of prison!'" type="missiontype.plot" faction="faction.civilian" difficulty="level.hard" abortable="false" activate="true">
          <briefing>
            <objective step="1" action="objective.custom" customaction="'Find a way out of prison!'"/>
          </briefing>
        </create_mission>
        <set_objective cue="$MissionCue" step="1" action="objective.custom" customaction="'Find a way out of prison!'" updatebriefing="true" comment="escape"/>
      </actions>
    </cue>
  </replace>
  <remove sel="//cue[@name='Ch2_Corridor_Guidance2']"/>
  <remove sel="//cue[@name='Ch2_Corridor_Guidance3']"/>
  <remove sel="//cue[@name='Ch2_PowerSwitch_Objective']"/>
  <remove sel="//cue[@name='Ch2_EnteredSpacesuit']"/>
  <remove sel="//cue[@name='Ch2_PowerSwitch_Nearby']"/>
  <remove sel="//cue[@name='Ch2_PowerSwitch_Functional']"/>
  <remove sel="//cue[@name='Ch2_Axiom_WalkToConsole_v2']"/>
  <remove sel="//cue[@name='Ch2_Axiom_Freed_NoCutscene']"/>
  <remove sel="//cue[@name='Ch2_Axiom_Freed_Cutscene']"/>
  <remove sel="//cue[@name='Ch2_Axiom_Hacking']"/>
  <remove sel="//cue[@name='Ch2_AirlockSwitch_Objective']"/>
  <remove sel="//cue[@name='Ch2_PickupCrate']"/>
  <remove sel="//cue[@name='Ch2_PickupCrate_Dialog_Finished']"/>
  <remove sel="//cue[@name='Ch2_LowerAirlock_NearbyNotArmed']"/>
  <remove sel="//cue[@name='Ch2_LowerAirlock_NearbyAndArmed']"/>
  <remove sel="//cue[@name='Ch2_AirlockSwitch_Broken']"/>
  <remove sel="//cue[@name='Ch2_LowerAirlockPipe_Inside']"/>
  <remove sel="//cue[@name='Ch2_Call_EscapeShip_CreatePosition_DEBUG']"/>
  <remove sel="//cue[@name='Ch2_Call_EscapeShip2']"/>
  <replace sel="//check_value[@comment='only when in spacesuit']">
    <check_all>
      <check_value value="@player.controlled.isclass.spacesuit" comment="only when in spacesuit"/>
      <check_value value="player.ship.distanceto.{$PrisonMarker_25} lt 5.0"/>
    </check_all>
  </replace>
  <remove sel="//cue[@name='Ch2_LowerAirlockPipe_Exit']/conditions/check_value"/>
  <replace sel="//cue[@name='Ch2_LowerAirlockPipe_Exit']/actions/do_if">
    <signal_cue cue="Ch2_Alternative"/>
  </replace>
  <remove sel="//cue[@name='Ch2_LowerAirlockPipe_Exit']/actions/do_else"/>
  <remove sel="//cue[@name='Ch2_Failed_AxiomNotFreed']"/>
  <remove sel="//cue[@name='Ch2_AxiomSpacesuit_Spawn']"/>
  <remove sel="//cue[@name='Ch2_OnBoard']"/>
  <remove sel="//cue[@name='Ch2_AxiomPlayerReady']"/>
  <add sel="//unlock_achievement" pos="before">
    <remove_mission cue="$MissionCue" type="completed"/>
  </add>
  <add sel="//unlock_achievement" pos="before">
    <create_mission cue="$MissionCue" name="'Get to safety'" description="'Find a way back to the station.'" type="missiontype.plot" faction="faction.civilian" difficulty="level.hard" abortable="false" activate="true">
      <briefing>
        <objective step="1" action="objective.dockat" object="$PrisonStation"/>
      </briefing>
    </create_mission>
  </add>
  <add sel="//unlock_achievement" pos="before">
    <set_objective_from_briefing cue="$MissionCue" step="1"/>
  </add>
  <replace sel="//cue[@name='Ch2_Alternative']/actions/set_value">
    <cancel_cue cue="Ch1_Intro"/>
  </replace>
  <add sel="//find_dockingbay" pos="before">
    <set_value name="$StealShipMacro" exact="macro.ship_pir_s_fighter_01_a_macro"/>
  </add>
  <replace sel="//loadout/@ref">story_kyd_prison_gamestart</replace>
  <replace sel="//paint/@ware">ware.paintmod_0098</replace>
  <replace sel="//cue[@name='Ch2_AxiomSad']/@name">Ch2_StationDocked</replace>
  <remove sel="//cue[@name='Ch2_StationDocked']/@instantiate"/>
  <replace sel="//conditions/event_conversation_started">
    <event_object_changed_room object="player.entity"/>
  </replace>
  <add sel="//cue[@name='Ch2_StationDocked']/conditions">
    <check_value value="not player.ship.isclass.spacesuit"/>
  </add>
  <add sel="//cue[@name='Ch2_StationDocked']/actions" pos="before">
    <delay exact="1s"/>
  </add>
  <replace sel="//cue[@name='Ch2_StationDocked']/actions/speak">
    <remove_mission cue="$MissionCue" type="completed"/>
  </replace>
  <add sel="//cue[@name='Ch2_StationDocked']/actions">
    <create_mission cue="$MissionCue" name="'Steal a ship'" description="'Steal a ship docked at the station.'" type="missiontype.plot" faction="faction.civilian" difficulty="level.hard" abortable="false" activate="true">
      <briefing>
        <objective step="1" action="objective.goto" object="$StealShip"/>
      </briefing>
    </create_mission>
  </add>
  <add sel="//cue[@name='Ch2_StationDocked']/actions">
    <set_objective cue="$MissionCue" step="1" action="objective.custom" object="$StealShip" customaction="'Steal a ship!'" updatebriefing="true" comment="steal ship"/>
  </add>
  <remove sel="//cue[@name='Ch2_ShipToSteal_Guidance_DEBUG']"/>
  <add sel="//cue[@name='Ch2_ShipToSteal_Enter']/actions/cancel_cue" pos="before">
    <remove_mission cue="$MissionCue" type="completed"/>
  </add>
  <add sel="//cue[@name='Ch2_ShipToSteal_Enter']/actions/cancel_cue" pos="before">
    <remove_value name="md.$GlobalHintsDND"/>
  </add>
  <add sel="//cue[@name='Ch2_ShipToSteal_Undock']">
    <delay exact="3s"/>
  </add>
  <add sel="//cue[@name='Ch2_ShipToSteal_Undock']">
    <actions>
      <set_faction_relation faction="faction.ministry" otherfaction="faction.player" value="-0.1"/>
      <remove_value name="md.$GlobalHintsDND"/>
    </actions>
  </add>
  <remove sel="//cue[@name='Ch3_Raider']"/>
  <remove sel="//cue[@name='Prison_DEBUG']"/>
</diff>
