<?xml version='1.0' encoding='utf-8'?>
<diff>
  <add sel="//set_value[@name='$HQPosition']" pos="before">
    <find_sector name="$HQSectorHE" macro="macro.cluster_31_sector001_macro" comment="Heretic's End, the new HQ sector"/>
  </add>
  <replace sel="//cue[@name='Initialise']/actions/do_if/@value">player.module == 'x4ep1_gamestart_boron2' or player.module == 'x4ep1_gamestart_scientist' or $story_hq_boso or $story_hq_dal</replace>
  <replace sel="//cue[@name='Initialise']/actions/do_if/do_if[1]/@value">player.module == 'x4ep1_gamestart_boron2' or player.module == 'x4ep1_gamestart_scientist'</replace>
  <replace sel="//do_if[1]/find_station_by_true_owner/@space">player.galaxy</replace>
  <remove sel="//cue[@name='Initialise']/actions/do_elseif"/>
  <replace sel="//cue[@name='Initialise']/actions/do_else/set_value">
    <signal_cue cue="Phase_BosoOffer_Trigger"/>
  </replace>
  <remove sel="//signal_cue[@cue='Phase_SignalLeak']"/>
  <add sel="//library[@name='SetupHQ']" pos="before">
    <cue name="Phase_BosoOffer_Trigger">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <cues>
        <cue name="Phase_BosoOffer_Trigger_Check" checkinterval="1min">
          <conditions>
            <check_value value="true"/>
          </conditions>
          <actions>
            <signal_cue cue="Phase_BosoOffer"/>
          </actions>
        </cue>
      </cues>
    </cue>
  </add>
  <remove sel="//cue[@name='SignalLeak_Hint_Message']"/>
  <remove sel="//cue[@name='Phase_SignalLeak_Cancelled']"/>
  <replace sel="//cue[@name='Phase_SignalLeak']/@name">Phase_BosoOffer</replace>
  <add sel="//cue[@name='Phase_BosoOffer']/actions/include_actions" pos="after">
    <create_offer cue="Phase_BosoOffer" actor="$Boron_Mentor" name="{30201,600}" description="{30201,601}" type="missiontype.plot" group="missiongroup.story_boso" faction="faction.civilian" difficulty="level.easy">
      <briefing>
        <objective step="1" action="objective.contact" text="{30201,2}"/>
      </briefing>
    </create_offer>
  </add>
  <add sel="//cue[@name='Phase_BosoOffer']/actions/create_offer" pos="after">
    <write_incoming_message title="{99753,2000}" text="{99753,2001}" source="{30201,2}" object="$Boron_Mentor" highpriority="true" interaction="guidance"/>
  </add>
  <replace sel="//cue[@name='Phase_SignalLeak_Init']/@name">Phase_BosoOffer_Accepted</replace>
  <add sel="//cue[@name='Phase_BosoOffer_Accepted']/actions" pos="before">
    <conditions>
      <check_any>
        <event_object_signalled object="$Boron_Mentor" param="'accept'"/>
        <check_all>
          <event_conversation_next_section actor="$Boron_Mentor" choiceparam="Phase_BosoOffer"/>
          <check_value value="event.param == 'c_mission_accept'"/>
        </check_all>
      </check_any>
    </conditions>
  </add>
  <replace sel="//cue[@name='Phase_BosoOffer_Accepted']/actions/create_group">
    <do_if value="not $MissionCue.hasmission">
      <remove_offer cue="Phase_BosoOffer"/>
      <create_mission cue="$MissionCue" name="{30201,600}" description="{30201,601}" type="missiontype.plot" group="missiongroup.story_boso" faction="faction.civilian" difficulty="level.easy" abortable="false" icon="'briefing_boso_ta_02'" iconcaption="{30201,2}">
        <briefing/>
      </create_mission>
    </do_if>
  </replace>
  <remove sel="//set_value[@name='$SignalLeakActors']"/>
  <remove sel="//cue[@name='Phase_BosoOffer_Accepted']/actions/set_value"/>
  <remove sel="//cue[@name='Phase_BosoOffer_Accepted']/actions/signal_cue"/>
  <add sel="//cue[@name='Phase_BosoOffer_Accepted']/actions" pos="after">
    <cues>
      <cue name="Phase_BosoOffer_Intro_Broadcast">
        <delay exact="3s"/>
        <actions>
          <set_value name="Mentor_Speak_Helper.$Lines" exact="[[30201001, 0s], [30201020, 1s], [30201007, 1s], [30253018, 1s], [30253019, 1s], [30201009, 1s], [30222057, 1s]]"/>
          <signal_cue cue="Mentor_Speak_Helper"/>
        </actions>
        <cues>
          <cue name="Phase_BosoOffer_Intro_Done">
            <conditions>
              <event_speak_finished actor="$Boron_Mentor" line="30222057"/>
            </conditions>
            <actions>
              <set_objective cue="$MissionCue" step="1" action="objective.deploy" text="{99753,2010}" comment="Drop a nav beacon at desired HQ location"/>
            </actions>
            <cues>
              <cue name="Phase_BosoOffer_Beacon_Dropped" instantiate="true">
                <conditions>
                  <event_navbeacon_launched space="player.galaxy"/>
                  <check_value value="event.param2.isplayerowned and event.param2.isclass.navbeacon and Phase_BosoOffer_Beacon_Confirmed.state == cuestate.waiting"/>
                </conditions>
                <actions>
                  <set_value name="$DroppedBeacon" exact="event.param2"/>
                  <set_value name="$BeaconSector" exact="$DroppedBeacon.sector"/>
                  <create_position name="$BeaconPos" object="$DroppedBeacon" space="$BeaconSector"/>
                  <run_actions ref="Check_HQ_Warp_Destination" result="$BeaconResult">
                    <param name="Radius" value="10km"/>
                    <param name="Position" value="$BeaconPos"/>
                    <param name="Sector" value="$BeaconSector"/>
                    <param name="DebugChance" value="$DebugChance"/>
                  </run_actions>
                  <do_if value="$BeaconResult == 'impossible'">
                    <speak actor="$Boron_Mentor" priority="100" line="30228023" comment="immovable object in the target area"/>
                  </do_if>
                  <do_else>
                    <signal_cue cue="Phase_BosoOffer_Beacon_Confirmed"/>
                  </do_else>
                </actions>
              </cue>
              <cue name="Phase_BosoOffer_Beacon_Confirmed">
                <conditions>
                  <event_cue_signalled/>
                </conditions>
                <actions>
                  <set_value name="$FlyToDistance" exact="50km"/>
                  <get_safe_pos result="$HQSpawnPos" sector="$BeaconSector" x="$BeaconPos.x" y="$BeaconPos.y" z="$BeaconPos.z"/>
                  <get_safe_pos result="$BosoSafePos" sector="$BeaconSector" x="$HQSpawnPos.x" y="$HQSpawnPos.y" z="$HQSpawnPos.z + 50km"/>
                  <set_value name="Mentor_Speak_Helper.$Lines" exact="[[30201071, 0s], [10419, 0.6s]]"/>
                  <signal_cue cue="Mentor_Speak_Helper"/>
                  <set_objective cue="$MissionCue" step="2" action="objective.flyto" object="$BeaconSector" offset="$BosoSafePos" text="{30201,1012}" radius="2km" comment="Move to safe distance"/>
                </actions>
                <cues>
                  <cue name="Phase_BosoOffer_At_Safe_Distance" checkinterval="1s">
                    <conditions>
                      <check_value value="player.sector == $BeaconSector and player.ship and player.ship.distanceto.[$BeaconSector, $BosoSafePos] lt 2km"/>
                    </conditions>
                    <actions>
                      <speak actor="$Boron_Mentor" priority="100" line="30222058" comment="We are ready. Shall I begin?"/>
                    </actions>
                    <cues>
                      <cue name="Phase_BosoOffer_Begin_Confirmed">
                        <delay exact="2s"/>
                        <actions>
                          <signal_cue cue="Phase_BosoOffer_Spawn_HQ"/>
                        </actions>
                      </cue>
                    </cues>
                  </cue>
                </cues>
              </cue>
              <cue name="Phase_BosoOffer_Spawn_HQ">
                <conditions>
                  <event_cue_signalled/>
                </conditions>
                <actions>
                  <speak actor="$Boron_Mentor" line="30228026" comment="Goodness me!"/>
                  <set_objective cue="$MissionCue" step="3" action="objective.observe" object="$BeaconSector" offset="$HQSpawnPos" text="{20109,4901}" comment="Observe the arrival"/>
                  <create_ship macro="macro.ship_gen_xs_escapepod_01_a_macro" name="$TempEffectObject" sector="$BeaconSector">
                    <owner exact="faction.ownerless"/>
                    <position value="$HQSpawnPos"/>
                  </create_ship>
                </actions>
                <cues>
                  <cue name="Phase_BosoOffer_Warp_Effect">
                    <delay exact="2s"/>
                    <actions>
                      <do_if value="@$TempEffectObject.exists">
                        <set_value name="$HQZone" exact="$TempEffectObject.zone"/>
                        <set_value name="$EffectPos" exact="$TempEffectObject.position"/>
                      </do_if>
                      <do_else>
                        <set_value name="$HQZone" exact="player.zone"/>
                        <create_position name="$EffectPos" object="$BeaconSector" space="$HQZone" value="$HQSpawnPos"/>
                      </do_else>
                      <add_effect object="$HQZone" effect="'hq_warpin'">
                        <position value="$EffectPos"/>
                      </add_effect>
                      <set_value name="$EffectLength" exact="11s"/>
                      <do_if value="@$TempEffectObject.exists">
                        <destroy_object object="$TempEffectObject"/>
                      </do_if>
                      <speak actor="$Boron_Mentor" line="30228027" comment="The power system is stabilising."/>
                    </actions>
                    <cues>
                      <cue name="Phase_BosoOffer_Warp_Spawn">
                        <conditions>
                          <event_cue_completed cue="Phase_BosoOffer_Warp_Effect"/>
                        </conditions>
                        <delay exact="$EffectLength"/>
                        <actions>
                          <create_station name="$HQ" macro="macro.station_pla_headquarters_base_01_macro" sector="$BeaconSector" constructionplan="'x4ep1_playerheadquarters'" owner="faction.civilian" state="componentstate.operational">
                            <position value="$HQSpawnPos"/>
                          </create_station>
                          <set_object_name object="$HQ" page="20102" line="5001" comment="'Unknown Station'"/>
                          <set_known object="$HQ.zone" known="true"/>
                          <set_known object="$HQ.sector" known="true"/>
                          <set_known object="$HQ.cluster" known="true"/>
                          <set_value name="$HQSector" exact="$HQ.sector"/>
                          <set_value name="$HQSpawnSector" exact="$HQ.sector"/>
                          <set_value name="$HQPosition" exact="$HQ.position"/>
                          <set_value name="md.Signal_Leaks.Manager.$SuppressSignalLeakGeneration" exact="false"/>
                          <add_to_group groupname="md.NPC_Instantiation.Instantiation.$ExcludedObjects" object="$HQ"/>
                          <signal_cue_instantly cue="md.NPC_Instantiation.RequestRemoveObject" param="$HQ"/>
                          <do_if value="$HQ">
                            <speak actor="$Boron_Mentor" line="30222061" comment="It seems to have been successful."/>
                            <set_value name="$NextBosoChatTime" min="player.age + 3min" max="player.age + 5min"/>
                          </do_if>
                        </actions>
                        <cues>
                          <cue name="Phase_BosoOffer_Add_Dock">
                            <conditions>
                              <event_cue_completed cue="Phase_BosoOffer_Warp_Spawn"/>
                            </conditions>
                            <actions>
                              <create_construction_sequence macros="[macro.dockarea_arg_m_station_01_macro]" station="$HQ" base="$HQ.plannedconstruction.sequence" comment="async calculation"/>
                              <add_blueprints macros="macro.dockarea_arg_m_station_01_macro"/>
                            </actions>
                            <delay exact="5s"/>
                            <actions>
                              <do_if value="not $HQ.defencenpc">
                                <create_cue_actor name="$DefenceComputer" cue="this">
                                  <select tags="controlpost.defence.tag"/>
                                  <owner exact="faction.civilian"/>
                                </create_cue_actor>
                                <do_if value="$DefenceComputer">
                                  <assign_control_entity object="$HQ" actor="$DefenceComputer" post="controlpost.defence" transfer="true"/>
                                  <remove_cue_actor actor="$DefenceComputer" cue="this"/>
                                  <remove_value name="$DefenceComputer"/>
                                </do_if>
                              </do_if>
                              <do_if value="not $HQ.engineer">
                                <create_cue_actor name="$EngineerComputer" cue="this">
                                  <select tags="controlpost.engineer.tag"/>
                                  <owner exact="faction.civilian"/>
                                </create_cue_actor>
                                <do_if value="$EngineerComputer">
                                  <assign_control_entity object="$HQ" actor="$EngineerComputer" post="controlpost.engineer" transfer="true"/>
                                  <remove_cue_actor actor="$EngineerComputer" cue="this"/>
                                  <remove_value name="$EngineerComputer"/>
                                </do_if>
                              </do_if>
                              <do_if value="not $HQ.paidbuildplot.exists">
                                <set_value name="$Patch__BuildPlot" exact="$HQ.buildplot.max"/>
                                <set_build_plot object="$HQ" paid="true" x="$Patch__BuildPlot.x" y="$Patch__BuildPlot.y" z="$Patch__BuildPlot.z"/>
                                <remove_value name="$Patch__BuildPlot"/>
                              </do_if>
                              <run_actions ref="md.LIB_Generic.RequestObjectInvincibility">
                                <param name="Object" value="$HQ"/>
                                <param name="RequesterCue" value="namespace"/>
                              </run_actions>
                              <signal_cue cue="Phase_BosoOffer_HQ_Visible"/>
                            </actions>
                            <cues>
                              <cue name="Phase_BosoOffer_Create_HQ_With_Boso_and_Dockarea">
                                <conditions>
                                  <event_object_construction_sequence_created object="$HQ"/>
                                </conditions>
                                <actions>
                                  <do_if value="event.param">
                                    <apply_construction_sequence station="$HQ" sequence="event.param"/>
                                    <signal_cue cue="Manage_Boron_Tank_Room"/>
                                    <set_entity_traits entity="$Boron_Mentor" customhandler="true"/>
                                  </do_if>
                                </actions>
                              </cue>
                              <cue name="Phase_BosoOffer_HQ_Visible">
                                <conditions>
                                  <event_cue_signalled/>
                                </conditions>
                                <actions>
                                  <write_incoming_message title="{30201,20}" text="{30201,21}" source="{30201,2}" highpriority="true" read="false" object="$HQ" interaction="guidance"/>
                                  <set_known object="$HQ" known="true"/>
                                  <set_object_forced_radar_visible object="$HQ" visible="true"/>
                                  <set_objective cue="$MissionCue" step="3" action="objective.observe" object="$HQ" text="$HQ.knownname" comment="Observe the arrived station"/>
                                  <set_value name="Mentor_Speak_Helper.$Lines" exact="[[30253011, 0s], [30253012, 1s], [30253021, 1s], [30253022, 0.5s]]"/>
                                  <signal_cue cue="Mentor_Speak_Helper"/>
                                </actions>
                                <cues>
                                  <cue name="Phase_BosoOffer_Set_Dock_Objective">
                                    <conditions>
                                      <event_speak_finished actor="$Boron_Mentor" line="30253022"/>
                                    </conditions>
                                    <actions>
                                      <set_objective cue="$MissionCue" step="5" action="objective.dockat" object="$HQ" updatebriefing="true"/>
                                    </actions>
                                  </cue>
                                </cues>
                              </cue>
                              <cue name="Phase_BosoOffer_Player_Docks_At_HQ_First_Time">
                                <conditions>
                                  <check_any>
                                    <event_object_changed_object object="player.entity" newobject="$HQ"/>
                                    <check_all>
                                      <event_object_docked_at container="$HQ"/>
                                      <check_value value="global.$PlayerOccupiedShipGroup.indexof.{event.param}"/>
                                    </check_all>
                                  </check_any>
                                </conditions>
                                <actions>
                                  <find_room name="$HQRooms" object="$HQ" multiple="true"/>
                                  <do_for_each in="$HQRooms" name="$HQRoom">
                                    <set_room_locked room="$HQRoom" locked="true"/>
                                  </do_for_each>
                                  <set_value name="Mentor_Speak_Helper.$Lines" exact="[[30253023, 2s], [30253024, 0s], [30253025, 0s], [30253026, 0s], [30253027, 0s], [30253028, 0s], [30253029, 0s], [30253030, 0s], [30253031, 0s], [30253032, 0s], [30253033, 0s], [30253034, 0s], [30253035, 0s], [30253036, 0s]]"/>
                                  <signal_cue cue="Mentor_Speak_Helper"/>
                                </actions>
                                <cues>
                                  <cue name="Phase_BosoOffer_Player_Transfers_Ownership">
                                    <conditions>
                                      <event_speak_finished actor="$Boron_Mentor" line="30253032"/>
                                    </conditions>
                                    <actions>
                                      <do_for_each in="$HQRooms" name="$HQRoom">
                                        <set_room_locked room="$HQRoom" locked="false"/>
                                      </do_for_each>
                                      <run_actions ref="md.LIB_Generic.RequestObjectVulnerability">
                                        <param name="Object" value="$HQ"/>
                                        <param name="RequesterCue" value="namespace"/>
                                      </run_actions>
                                      <run_actions ref="md.LIB_Generic.TransferStationOwnership">
                                        <param name="Station" value="$HQ"/>
                                        <param name="Faction" value="faction.player"/>
                                      </run_actions>
                                      <include_actions ref="SetupHQ"/>
                                      <clear_object_name object="$HQ"/>
                                      <signal_cue cue="Manage_PlayerOffice_Room"/>
                                      <remove_from_group group="md.NPC_Instantiation.Instantiation.$ExcludedObjects" object="$HQ"/>
                                      <signal_cue_instantly cue="md.NPC_Instantiation.RequestAddObject" param="$HQ"/>
                                      <set_entity_traits entity="$Boron_Mentor" missionactor="true" customhandler="true" subtitlename="true"/>
                                      <set_objective cue="$MissionCue" step="5" action="objective.talkto" object="$Boron_Mentor" updatebriefing="true"/>
                                    </actions>
                                    <cues>
                                      <cue name="Phase_BosoOffer_BosoIntroduced">
                                        <conditions>
                                          <event_conversation_started actor="$Boron_Mentor"/>
                                        </conditions>
                                        <delay exact="1s"/>
                                        <actions>
                                          <remove_mission cue="$MissionCue" type="completed"/>
                                        </actions>
                                      </cue>
                                    </cues>
                                  </cue>
                                </cues>
                              </cue>
                            </cues>
                          </cue>
                        </cues>
                      </cue>
                    </cues>
                  </cue>
                </cues>
              </cue>
            </cues>
          </cue>
        </cues>
      </cue>
    </cues>
  </add>
  <remove sel="//cue[@name='Phase_SignalLeak_Reset_Helper']"/>
  <remove sel="//cue[@name='Phase_SignalLeak_Find_Station']"/>
  <replace sel="//cue[@name='Datavaults']/cues/cue/conditions/check_value/@value">$CurrentPhase != Phase_BosoOffer</replace>
</diff>
